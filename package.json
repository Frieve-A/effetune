{
  "name": "effetune",
  "version": "2.5.0",
  "private": true,
  "description": "Desktop Audio Effect Processor",
  "main": "electron/main.js",
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "start": "electron .",
    "build:vendor": "node scripts/verify-sqlite-wasm-vendor.mjs && node scripts/build-music-metadata-vendor.mjs",
    "gen:dsp": "node scripts/gen-dsp-params.mjs",
    "build:dsp": "node scripts/build-dsp-wasm.mjs",
    "build:openhome-sidecar": "node scripts/build-openhome-sidecar.mjs",
    "collect:openhome-linux-provenance": "node tools/openhome-linux-provenance.mjs",
    "verify:openhome-linux-provenance": "node tools/openhome-linux-provenance.mjs --verify",
    "test:dsp": "node scripts/build-dsp-wasm.mjs --native-tests",
    "test:dsp:automation": "node tools/verify-dsp-automation.mjs",
    "test:dsp:warnings": "node scripts/build-dsp-wasm.mjs --native-test-warning-check",
    "test:dsp:parity": "npm --prefix dsp/bindings/js run build && node tools/dsp-parity/graph-v1.mjs && node tools/dsp-parity/run.mjs --wasm && node tools/dsp-parity/run.mjs --wasm --simd",
    "test:dsp:telemetry-soak": "node tools/dsp-parity/telemetry-soak.mjs",
    "test:power-browser": "node tools/run-power-browser-smoke.mjs",
    "smoke:dsp-package": "node tools/verify-dsp-package.mjs dist",
    "smoke:openhome-package": "node tools/verify-openhome-package.mjs dist",
    "docs:dsp": "node examples/dsp-library/generate-docs.mjs",
    "docs:dsp:check": "node examples/dsp-library/verify-site-inputs.mjs && node examples/dsp-library/generate-docs.mjs --check",
    "assets:web": "npm run build:vendor && node scripts/generate-sw-precache.js",
    "assets:web:check": "npm run build:vendor && node scripts/generate-sw-precache.js --check",
    "check:install-scripts": "node scripts/check-install-scripts.mjs",
    "lint": "eslint electron js plugins features scripts tools tests --max-warnings=0",
    "test": "npm --prefix dsp/bindings/js run build && node tools/run-tests.mjs",
    "test:library-scale:quick": "node tests/scale/library-scale-generation.mjs --size 10000",
    "test:library-scale:million": "node tests/scale/library-scale-generation.mjs --preset million",
    "test:library-scale:boundary": "node tests/scale/library-scale-generation.mjs --preset boundary",
    "test:library-scale:endurance": "node tools/library-scale/run-scale.mjs --preset boundary",
    "test:library-scale:reference": "node tools/library-scale/run-fixed-reference-performance.mjs",
    "test:library-scale:sqlite": "node tools/library-scale/benchmark-electron-sqlite.cjs --size 10000",
    "test:library-sqlite:web": "node tools/library-scale/run-web-sqlite.mjs --contract",
    "test:library-scale:web-sqlite": "node tools/library-scale/run-web-sqlite.mjs --size 1000000",
    "verify": "npm run assets:web:check && npm run check:install-scripts && npm run lint && npm test",
    "clean": "rimraf dist node_modules/.cache",
    "build": "npm run assets:web && npm run clean && npm run build:openhome-sidecar -- --no-publish-development && electron-builder --win --publish never",
    "build:portable": "npm run assets:web && npm run clean && npm run build:openhome-sidecar -- --no-publish-development && electron-builder --win portable --publish never",
    "build:installer": "npm run assets:web && npm run clean && npm run build:openhome-sidecar -- --no-publish-development && electron-builder --win nsis --publish never",
    "build:mac:arm64": "npm run assets:web && npm run clean && npm run build:openhome-sidecar -- --arch arm64 --no-publish-development && electron-builder --mac --arm64 --publish never",
    "build:mac:x64": "npm run assets:web && npm run clean && npm run build:openhome-sidecar -- --arch x64 --no-publish-development && electron-builder --mac --x64 --publish never",
    "build:linux": "npm run assets:web && npm run clean && npm run build:openhome-sidecar -- --no-publish-development && electron-builder --linux --publish never",
    "pack": "npm run assets:web && npm run clean && npm run build:openhome-sidecar -- --no-publish-development && electron-builder --dir",
    "pack:win": "npm run assets:web && npm run clean && npm run build:openhome-sidecar -- --no-publish-development && electron-builder --dir --win --publish never && npm run smoke:openhome-package",
    "dist": "npm run assets:web && npm run clean && npm run build:openhome-sidecar -- --no-publish-development && electron-builder"
  },
  "author": "Frieve",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "cross-env": "^10.1.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.7.0",
    "eslint-plugin-electron": "^7.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.11.0",
    "playwright": "^1.62.1",
    "rimraf": "^6.1.3"
  },
  "build": {
    "appId": "com.frieve.effetune",
    "productName": "EffeTune",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "js/**/*",
      "plugins/**/*",
      "!plugins/dsp/effetune-dsp.debug.wasm",
      "features/**/*",
      "presets/**/*",
      "images/**/*",
      "docs/**/*",
      "effetune.html",
      "effetune.css",
      "effetune-mobile.css",
      "effetune-library.css",
      "pipeline-analyzer.css",
      "sw.js",
      "sw-precache.js",
      "manifest.json",
      "package.json",
      "LICENSE",
      "README.md"
    ],
    "fileAssociations": [
      {
        "ext": "effetune_preset",
        "name": "EffeTune Preset",
        "description": "EffeTune Preset File",
        "icon": "icon",
        "role": "Editor"
      },
      {
        "ext": "mp3",
        "name": "MP3 Audio",
        "description": "MP3 Audio File",
        "icon": "icon",
        "role": "None"
      },
      {
        "ext": "wav",
        "name": "WAV Audio",
        "description": "WAV Audio File",
        "icon": "icon",
        "role": "None"
      },
      {
        "ext": "ogg",
        "name": "OGG Audio",
        "description": "OGG Audio File",
        "icon": "icon",
        "role": "None"
      },
      {
        "ext": "flac",
        "name": "FLAC Audio",
        "description": "FLAC Audio File",
        "icon": "icon",
        "role": "None"
      },
      {
        "ext": "m4a",
        "name": "M4A Audio",
        "description": "M4A Audio File",
        "icon": "icon",
        "role": "None"
      },
      {
        "ext": "mp4",
        "name": "MP4 Audio",
        "description": "MP4 Audio File",
        "icon": "icon",
        "role": "None"
      },
      {
        "ext": "aac",
        "name": "AAC Audio",
        "description": "AAC Audio File",
        "icon": "icon",
        "role": "None"
      },
      {
        "ext": "opus",
        "name": "OPUS Audio",
        "description": "OPUS Audio File",
        "icon": "icon",
        "role": "None"
      },
      {
        "ext": "webm",
        "name": "WEBM Audio",
        "description": "WEBM Audio File",
        "icon": "icon",
        "role": "None"
      }
    ],
    "win": {
      "extraResources": [
        {
          "from": "native/openhome-sidecar/build/win32-x64/effetune-openhome-sidecar.exe",
          "to": "openhome/effetune-openhome-sidecar.exe"
        },
        {
          "from": "native/openhome-sidecar/THIRD_PARTY_NOTICES.txt",
          "to": "openhome/THIRD_PARTY_NOTICES.txt"
        }
      ],
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "EffeTune",
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "installerHeaderIcon": "icon.ico",
      "artifactName": "${productName}-${version}-Setup.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-Portable.${ext}"
    },
    "mac": {
      "extraResources": [
        {
          "from": "native/openhome-sidecar/build/darwin-${arch}/effetune-openhome-sidecar",
          "to": "openhome/effetune-openhome-sidecar"
        },
        {
          "from": "native/openhome-sidecar/THIRD_PARTY_NOTICES.txt",
          "to": "openhome/THIRD_PARTY_NOTICES.txt"
        }
      ],
      "target": "dmg",
      "category": "public.app-category.music",
      "darkModeSupport": true,
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "dmg": {},
    "linux": {
      "extraResources": [
        {
          "from": "native/openhome-sidecar/build/linux-${arch}/effetune-openhome-sidecar",
          "to": "openhome/effetune-openhome-sidecar"
        },
        {
          "from": "native/openhome-sidecar/build/linux-${arch}",
          "to": "openhome",
          "filter": [
            "libnl*-3.so*"
          ]
        },
        {
          "from": "native/openhome-sidecar/build/linux-${arch}/libnl-runtime-manifest.json",
          "to": "openhome/libnl-runtime-manifest.json"
        },
        {
          "from": "native/openhome-sidecar/THIRD_PARTY_NOTICES.txt",
          "to": "openhome/THIRD_PARTY_NOTICES.txt"
        },
        {
          "from": "native/openhome-sidecar/licenses/libnl-LGPL-2.1.txt",
          "to": "openhome/libnl-LGPL-2.1.txt"
        }
      ],
      "target": "AppImage",
      "category": "Audio",
      "executableName": "effetune",
      "desktop": {
        "entry": {
          "Name": "EffeTune",
          "Comment": "Desktop Audio Effect Processor",
          "GenericName": "Audio Processor",
          "StartupWMClass": "EffeTune"
        }
      }
    },
    "asar": true,
    "asarUnpack": [],
    "npmRebuild": false
  },
  "dependencies": {
    "music-metadata": "^11.14.0"
  }
}
