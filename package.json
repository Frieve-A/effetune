{
  "name": "effetune",
  "version": "2.16.0",
  "private": true,
  "description": "Desktop Audio Effect Processor",
  "main": "electron/main.js",
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "build:extension": "node scripts/build-extension.mjs",
    "test:extension-browser": "node tools/run-extension-browser-smoke.mjs",
    "start": "electron .",
    "build:vendor": "node scripts/verify-sqlite-wasm-vendor.mjs && node scripts/build-music-metadata-vendor.mjs && node scripts/build-offline-audio-encoders-vendor.mjs && node scripts/build-playback-decoder-vendor.mjs",
    "gen:dsp": "node scripts/gen-dsp-params.mjs",
    "build:dsp": "node scripts/build-dsp-wasm.mjs",
    "build:openhome-sidecar": "node scripts/build-openhome-sidecar.mjs",
    "build:airplay-receiver": "node scripts/build-airplay-receiver.mjs",
    "collect:openhome-linux-provenance": "node tools/openhome-linux-provenance.mjs",
    "verify:openhome-linux-provenance": "node tools/openhome-linux-provenance.mjs --verify",
    "test:dsp": "node scripts/build-dsp-wasm.mjs --native-tests",
    "test:dsp:automation": "node tools/verify-dsp-automation.mjs",
    "test:dsp:warnings": "node scripts/build-dsp-wasm.mjs --native-test-warning-check",
    "test:dsp:parity": "npm --prefix dsp/bindings/js run build && node tools/dsp-parity/graph-v1.mjs && node tools/dsp-parity/run.mjs --wasm && node tools/dsp-parity/run.mjs --wasm --simd",
    "test:dsp:telemetry-soak": "node tools/dsp-parity/telemetry-soak.mjs",
    "bench:score-reference": "node tools/benchmark-score-reference.mjs",
    "test:browser": "node tools/run-tests.mjs --browser",
    "test:desktop-browser": "node --test --test-concurrency=1 tests/esm/desktop-browser-electron-browser.test.mjs",
    "test:power-browser": "node tools/run-power-browser-smoke.mjs",
    "test:rolling-pcm:endurance": "node --test tests/esm/rolling-pcm-endurance-browser.test.mjs",
    "test:rolling-pcm:electron": "node tools/run-tests.mjs --electron",
    "smoke:rolling-pcm-distribution": "node tools/run-rolling-pcm-distribution-smoke.mjs dist",
    "smoke:rolling-pcm-package": "node tools/verify-rolling-pcm-package.mjs",
    "smoke:dsp-package": "node tools/verify-dsp-package.mjs dist",
    "smoke:openhome-package": "node tools/verify-openhome-package.mjs dist",
    "smoke:airplay-package": "node tools/verify-airplay-package.mjs dist",
    "docs:dsp": "node examples/dsp-library/generate-docs.mjs",
    "docs:dsp:check": "node examples/dsp-library/verify-site-inputs.mjs && node examples/dsp-library/generate-docs.mjs --check",
    "assets:web": "npm run build:vendor && node scripts/generate-sw-precache.js",
    "assets:web:check": "npm run build:vendor && node scripts/generate-sw-precache.js --check",
    "check:install-scripts": "node scripts/check-install-scripts.mjs",
    "lint": "eslint electron js plugins features scripts tools tests extension --max-warnings=0",
    "test": "npm --prefix dsp/bindings/js run build && node tools/run-tests.mjs",
    "check:presets": "node tools/preset-render-check.mjs",
    "test:tube-calibration": "node --test tests/esm/dsp-tube-simulator-listening-presets-v1.test.mjs",
    "test:library-scale:quick": "node tests/scale/library-scale-generation.mjs --size 10000",
    "test:library-scale:million": "node tests/scale/library-scale-generation.mjs --preset million",
    "test:library-scale:boundary": "node tests/scale/library-scale-generation.mjs --preset boundary",
    "test:library-scale:endurance": "node tools/library-scale/run-scale.mjs --preset boundary",
    "test:library-scale:reference": "node tools/library-scale/run-fixed-reference-performance.mjs",
    "test:library-scale:sqlite": "node tools/library-scale/benchmark-electron-sqlite.cjs --size 10000",
    "test:library-sqlite:web": "node tools/library-scale/run-web-sqlite.mjs --contract",
    "test:library-scale:web-sqlite": "node tools/library-scale/run-web-sqlite.mjs --size 1000000",
    "verify": "npm run assets:web:check && npm run check:install-scripts && npm run lint && npm test",
    "clean": "rimraf dist node_modules/.cache",
    "build": "npm run assets:web && npm run clean && npm run build:openhome-sidecar -- --no-publish-development && npm run build:airplay-receiver && electron-builder --win --publish never",
    "build:portable": "npm run assets:web && npm run clean && npm run build:openhome-sidecar -- --no-publish-development && npm run build:airplay-receiver && electron-builder --win portable --publish never",
    "build:installer": "npm run assets:web && npm run clean && npm run build:openhome-sidecar -- --no-publish-development && npm run build:airplay-receiver && electron-builder --win nsis --publish never",
    "build:mac:arm64": "npm run assets:web && npm run clean && npm run build:openhome-sidecar -- --arch arm64 --no-publish-development && npm run build:airplay-receiver -- --arch arm64 && electron-builder --mac --arm64 --publish never",
    "build:mac:x64": "npm run assets:web && npm run clean && npm run build:openhome-sidecar -- --arch x64 --no-publish-development && npm run build:airplay-receiver -- --arch x64 && electron-builder --mac --x64 --publish never",
    "build:linux": "npm run assets:web && npm run clean && npm run build:openhome-sidecar -- --no-publish-development && npm run build:airplay-receiver && electron-builder --linux --publish never",
    "pack": "npm run assets:web && npm run clean && npm run build:openhome-sidecar -- --no-publish-development && npm run build:airplay-receiver && electron-builder --dir",
    "pack:win": "npm run assets:web && npm run clean && npm run build:openhome-sidecar -- --no-publish-development && npm run build:airplay-receiver && electron-builder --dir --win --publish never && npm run smoke:openhome-package && npm run smoke:airplay-package",
    "pack:ecs:win": "npm run assets:web && npm run build:openhome-sidecar -- --no-publish-development && npm run build:airplay-receiver && node scripts/pack-ecs.mjs",
    "pack:msix:win": "node scripts/pack-msix-win.mjs",
    "test:msix:installed": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/test-msix-installed.ps1",
    "publish:msstore": "node scripts/publish-msstore.mjs",
    "dist": "npm run assets:web && npm run clean && npm run build:openhome-sidecar -- --no-publish-development && npm run build:airplay-receiver && electron-builder"
  },
  "author": "Frieve",
  "license": "MIT",
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "playwright": "^1.64.1",
    "rimraf": "^6.1.3"
  },
  "build": {
    "appId": "com.frieve.effetune",
    "productName": "EffeTune",
    "publish": {
      "provider": "github",
      "owner": "Frieve-A",
      "repo": "effetune"
    },
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "js/**/*",
      "plugins/**/*",
      "!plugins/dsp/effetune-dsp.debug.wasm",
      "features/**/*",
      "presets/**/*",
      "images/**/*",
      "docs/**/*",
      "effetune.html",
      "css/**/*",
      "remote.html",
      "sw.js",
      "sw-precache.js",
      "manifest.json",
      "package.json",
      "LICENSE",
      "README.md"
    ],
    "fileAssociations": [
      {
        "ext": "effetune_preset",
        "name": "EffeTune Preset",
        "description": "EffeTune Preset File",
        "icon": "icon",
        "role": "Editor"
      },
      {
        "ext": "mp3",
        "name": "MP3 Audio",
        "description": "MP3 Audio File",
        "icon": "icon",
        "role": "None"
      },
      {
        "ext": "wav",
        "name": "WAV Audio",
        "description": "WAV Audio File",
        "icon": "icon",
        "role": "None"
      },
      {
        "ext": "ogg",
        "name": "OGG Audio",
        "description": "OGG Audio File",
        "icon": "icon",
        "role": "None"
      },
      {
        "ext": "flac",
        "name": "FLAC Audio",
        "description": "FLAC Audio File",
        "icon": "icon",
        "role": "None"
      },
      {
        "ext": "m4a",
        "name": "M4A Audio",
        "description": "M4A Audio File",
        "icon": "icon",
        "role": "None"
      },
      {
        "ext": "mp4",
        "name": "MP4 Audio",
        "description": "MP4 Audio File",
        "icon": "icon",
        "role": "None"
      },
      {
        "ext": "aac",
        "name": "AAC Audio",
        "description": "AAC Audio File",
        "icon": "icon",
        "role": "None"
      },
      {
        "ext": "opus",
        "name": "OPUS Audio",
        "description": "OPUS Audio File",
        "icon": "icon",
        "role": "None"
      },
      {
        "ext": "webm",
        "name": "WEBM Audio",
        "description": "WEBM Audio File",
        "icon": "icon",
        "role": "None"
      },
      {
        "ext": "m4v",
        "name": "M4V Video",
        "description": "M4V Video File",
        "icon": "icon",
        "role": "None"
      },
      {
        "ext": "mov",
        "name": "MOV Video",
        "description": "MOV Video File",
        "icon": "icon",
        "role": "None"
      },
      {
        "ext": "mkv",
        "name": "MKV Video",
        "description": "MKV Video File",
        "icon": "icon",
        "role": "None"
      },
      {
        "ext": "3gp",
        "name": "3GP Video",
        "description": "3GP Video File",
        "icon": "icon",
        "role": "None"
      }
    ],
    "win": {
      "extraResources": [
        {
          "from": "out/native/airplay-receiver/win32-x64",
          "to": "airplay",
          "filter": ["**/*", "!source{,/**/*}"]
        },
        {
          "from": "out/native/openhome-sidecar/win32-x64/effetune-openhome-sidecar.exe",
          "to": "openhome/effetune-openhome-sidecar.exe"
        },
        {
          "from": "native/openhome-sidecar/THIRD_PARTY_NOTICES.txt",
          "to": "openhome/THIRD_PARTY_NOTICES.txt"
        }
      ],
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "include": "electron/airplay-installer.nsh",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "EffeTune",
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "installerHeaderIcon": "icon.ico",
      "artifactName": "${productName}-${version}-Setup.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-Portable.${ext}"
    },
    "mac": {
      "extraResources": [
        {
          "from": "out/native/airplay-receiver/darwin-${arch}",
          "to": "airplay",
          "filter": ["**/*", "!source{,/**/*}"]
        },
        {
          "from": "out/native/openhome-sidecar/darwin-${arch}/effetune-openhome-sidecar",
          "to": "openhome/effetune-openhome-sidecar"
        },
        {
          "from": "native/openhome-sidecar/THIRD_PARTY_NOTICES.txt",
          "to": "openhome/THIRD_PARTY_NOTICES.txt"
        }
      ],
      "target": "dmg",
      "category": "public.app-category.music",
      "darkModeSupport": true,
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "dmg": {},
    "linux": {
      "extraResources": [
        {
          "from": "out/native/airplay-receiver/linux-${arch}",
          "to": "airplay",
          "filter": ["**/*", "!source{,/**/*}"]
        },
        {
          "from": "out/native/openhome-sidecar/linux-${arch}/effetune-openhome-sidecar",
          "to": "openhome/effetune-openhome-sidecar"
        },
        {
          "from": "out/native/openhome-sidecar/linux-${arch}",
          "to": "openhome",
          "filter": [
            "libnl*-3.so*"
          ]
        },
        {
          "from": "out/native/openhome-sidecar/linux-${arch}/libnl-runtime-manifest.json",
          "to": "openhome/libnl-runtime-manifest.json"
        },
        {
          "from": "native/openhome-sidecar/THIRD_PARTY_NOTICES.txt",
          "to": "openhome/THIRD_PARTY_NOTICES.txt"
        },
        {
          "from": "native/openhome-sidecar/licenses/libnl-LGPL-2.1.txt",
          "to": "openhome/libnl-LGPL-2.1.txt"
        }
      ],
      "target": "AppImage",
      "category": "Audio",
      "executableName": "effetune",
      "desktop": {
        "entry": {
          "Name": "EffeTune",
          "Comment": "Desktop Audio Effect Processor",
          "GenericName": "Audio Processor",
          "StartupWMClass": "EffeTune"
        }
      }
    },
    "asar": true,
    "asarUnpack": [],
    "npmRebuild": false
  },
  "dependencies": {
    "@mediabunny/flac-encoder": "1.64.0",
    "electron-updater": "6.8.11",
    "mediabunny": "1.64.0",
    "music-metadata": "^12.3.2",
    "qrcode-generator": "^2.0.4",
    "ws": "^8.22.0"
  },
  "overrides": {
    "@electron/get": {
      "global-agent": "4.1.3"
    }
  }
}
