  "analysis:diagOrderAt": "{order} عند {span}",
  "analysis:diagListSeparator": "، ",
  "analysis:diagR1Obs": "تشوه من الرتب الزوجية بقانون التربيع: ينخفض {source} بمقدار {m} dB عند خفض Signal Level بمقدار 6 dB عند {span} ({chart}).",
  "analysis:diagR1SourceEven": "التشوه من الرتب الزوجية",
  "analysis:diagR1SourceH2": "H2",
  "analysis:diagR1Cause": "يُرجَّح وجود عدم تماثل في النظام المغناطيسي أو في تعليق المخروط في السماعة.",
  "analysis:diagR1Action": "فعّل التصحيح (Filter Length {length}). انخفاض التشوه من الرتب الزوجية: {a} dB عند Signal Level المضبوط ({kind})، و{b} dB عند Signal Level أقل بمقدار 6 dB (متوقع).",
  "analysis:diagR1ActionNoL6": "فعّل التصحيح (Filter Length {length}). انخفاض التشوه من الرتب الزوجية: {a} dB عند Signal Level المضبوط ({kind})؛ وعند Signal Level أقل بمقدار 6 dB يكون أصغر من أن يُقاس.",
  "analysis:diagR1NearOnly": " يعمل أساسًا قرب Signal Level المضبوط.",
  "analysis:diagR1NotExpected": "لا يُتوقع أن يفيد التصحيح في هذا النظام.",
  "analysis:speakerDistortionShortPrefix": "مرشّح Short: {reason}",
  "analysis:speakerDistortionLongPrefix": "مرشّح Long: {reason}",
  "message:speakerDistortionReasonBelowLimit": "كان نوع التشوه الذي يزيله هذا التصحيح أصغر من أن يُقاس هنا، لذا يبقى التصحيح متوقفًا. إذا كانت الغرفة صاخبة، فأعد القياس عندما تكون هادئة.",
  "message:speakerDistortionReasonNoFit": "تعذر تحليل القياس. تأكد من أن الغرفة هادئة وأن الميكروفون متصل، ثم أعد القياس.",
  "message:speakerDistortionReasonLittleGain": "في فحص التصحيح، لم يخفّض التصحيح تشوه هذه السماعة إلا قليلًا، لذا يبقى متوقفًا. تتشوه سماعات كثيرة بطرق لا يستطيع هذا التصحيح تخفيضها.",
  "message:speakerDistortionReasonWorseInCheck": "في فحص التصحيح، جعل التصحيح التشوه {band} أسوأ، لذا يبقى متوقفًا.",
  "message:speakerDistortionReasonWorseInCheckTotal": "في فحص التصحيح، زاد التصحيح التشوه الكلي، لذا يبقى متوقفًا.",
  "message:speakerDistortionReasonWorseForSingleTones": "سيضيف التصحيح تشوهًا إلى النغمات المفردة {band}، لذا يبقى متوقفًا.",
  "message:speakerDistortionReasonWorseAtLowerVolume": "يفيد التصحيح عند Signal Level المضبوط، لكنه سيزيد التشوه عند الاستماع بصوت أخفض، لذا يبقى متوقفًا.",
  "message:speakerDistortionReasonWorseAtLoudPeaks": "يفيد التصحيح عند Signal Level المضبوط، لكنه سيزيد التشوه عند الذروات العالية، لذا يبقى متوقفًا.",
  "message:speakerDistortionOddAlso": "الرتب الفردية: صُحّحت أيضًا.",
  "message:speakerDistortionOddAlone": "الرتب الفردية: مصحَّحة.",
  "message:speakerDistortionOddNotChecked": "الرتب الفردية: متوقفة، لم يؤكدها فحص التصحيح بعد. شغّل «إعادة الفحص» ليقرر Auto.",
  "message:speakerDistortionOddLittleGain": "الرتب الفردية: متوقفة، فقد قاس الفحص انخفاضًا أقل من 1 dB.",
  "message:speakerDistortionOddWorseWhenLoud": "الرتب الفردية: متوقفة، فقد خفّضت التشوه من الرتب الفردية عند المستوى المضبوط لكنها رفعت التشوه عند مستوى صوت مرتفع.",
  "message:speakerDistortionOddWorseOverall": "الرتب الفردية: متوقفة، فهي تُضعف تصحيح الرتب الزوجية أكثر مما تفيد، فلن ينخفض التشوه الكلي.",
  "message:speakerDistortionOddWorseOverallAlone": "الرتب الفردية: متوقفة، فلن ينخفض التشوه الكلي.",
  "message:speakerDistortionOddFitLittleGain": "الرتب الفردية: متوقفة، إذ يُتوقع أن تخفّض التشوه من الرتب الفردية بأقل من 1 dB.",
  "message:speakerDistortionOddFitWorseInCheck": "الرتب الفردية: متوقفة، إذ يُتوقع أن ترفع التشوه من الرتب الفردية في جزء من النطاق.",
  "message:speakerDistortionOddFitWorseForSingleTones": "الرتب الفردية: متوقفة، إذ يُتوقع أن ترفع التشوه من الرتب الفردية في النغمات المفردة.",
  "message:speakerDistortionOddFitWorseAtLowerVolume": "الرتب الفردية: متوقفة، إذ يُتوقع أن ترفع التشوه من الرتب الفردية عند مستوى صوت أخفض.",
  "message:speakerDistortionOddBelowLimit": "لا تصحيح للرتب الفردية: كان التشوه من الرتب الفردية أصغر من أن يُقاس.",
  "message:speakerDistortionOddNoFit": "لا تصحيح للرتب الفردية: تعذر إنشاء نموذج من القياس.",
  "message:speakerDistortionBandBelow100": "أقل من 100 Hz",
  "message:speakerDistortionBand100to400": "بين 100 و400 Hz",
  "message:speakerDistortionBand400to2k": "بين 400 Hz و2 kHz",
  "message:speakerDistortionBand50to8k": "بين 50 Hz و8 kHz",
  "message:speakerDistortionBandAbove2k": "فوق 2 kHz",
  "analysis:diagR2Obs": "تشوه لا يتأثر بالمستوى: يتغير {list} بأقل من 2 dB عند خفض Signal Level بمقدار 6 dB ({chart}).",
  "analysis:diagR2Cause": "يُرجَّح أنه التخلف المغناطيسي في النظام المغناطيسي للسماعة، أو ملف مقسّم التردد ذو القلب الحديدي، أو مرشّح الخرج في مضخم صغير من الفئة D، أو الاحتكاك، أو محدّد المستوى، أو معالجة DSP.",
  "analysis:diagR2Action": "لن يخفّ التشوه بخفض الصوت. تحقق من إعدادات DSP ومحدّد المستوى، أو أجرِ القياس بمضخم آخر وقارن بين القياسين.",
  "analysis:diagR3Obs": "تشوه يزداد عند المستوى المنخفض: يرتفع {list} بما لا يقل عن 2 dB عند خفض Signal Level بمقدار 6 dB ({chart}).",
  "analysis:diagR3Cause": "يُرجَّح أنه تشوه عبور الصفر أو تشوه الزمن الميت في مرحلة خرج المضخم، أو الاحتكاك.",
  "analysis:diagR3Action": "جرّب مضخمًا آخر أو خرجًا آخر، ثم قارن بين القياسين.",
  "analysis:diagR4Obs": "بداية مفاجئة: {k} من التوافقيات أقوى بما لا يقل عن 10 dB عند Signal Level المضبوط منها عند مستوى أقل بمقدار 6 dB، عند {span} ({chart}).",
  "analysis:diagR4Cause": "يُرجَّح أنه قصّ للإشارة، أو بلوغ المخروط نهاية مداه، أو محدّد المستوى.",
  "analysis:diagR4Action": "استمع بصوت أخفض. يبدأ هذا التشوه بين Signal Level المضبوط والمستوى الأقل منه بمقدار 6 dB، حول {span}.",
  "analysis:diagR5Obs": "خشخشة حول {span} ({chart}).",
  "analysis:diagR5Action": "ربما يهتز شيء مفكوك في السماعة أو قربها، مثل لوح أو الشبكة الأمامية أو غرض على الرف. أصغِ إلى الخشخشة حول {span} أثناء تشغيل إشارة الاختبار، ثم أصلح مصدرها أو أزِله.",
  "button:excludeRattle": "صحّح فقط ما دون {f} (لتجنّب الخشخشة)",
  "analysis:rattleOutside": "إنها بالفعل فوق Upper Limit.",
  "analysis:diagR6Obs": "طنين: يرتفع {f} Hz بمقدار {e} dB فوق الضوضاء المجاورة في الصمت ({chart}).",
  "analysis:diagR6Cause": "يُرجَّح أنه حلقة أرضية أو طنين من مصدر التغذية.",
  "analysis:diagR6Action": "تحقق من وصلة التأريض، أو وصّل كل الأجهزة بمشترك كهربائي واحد، أو جرّب مسارًا آخر للكابلات.",
  "analysis:diagOverloadObs": "الصوت مرتفع جدًا: عند Signal Level المضبوط يصبح الصوت عند {span} أخفض مما ينبغي بما يصل إلى {m} dB ({chart}).",
  "analysis:diagOverloadCause": "بلغ المضخم أو السماعة أعلى صوت يمكنه إخراجه، فينقطع الصوت عند هذا الحد ويتشوّه.",
  "analysis:diagOverloadAction": "اخفض مستوى صوت المضخم أو Signal Level، ثم أعد القياس. لا يمكن تصحيح هذا التشوه، ولا يعمل التصحيح إلا عند مستويات صوت أقل من هذا الحد.",
  "analysis:diagR7Obs": "ينخفض الكسب بما لا يقل عن 0.3 dB عند Signal Level المضبوط في النطاق 200 Hz – 8 kHz كله ({chart}).",
  "analysis:diagR7Cause": "يُرجَّح أن جهد تغذية المضخم ينخفض، أو أن محدّد المستوى يعمل.",
  "analysis:diagR7Action": "استمع بصوت أخفض أو استخدم مضخمًا أقوى.",
  "analysis:diagR8Obs": "ضغط الجهير: ينخفض الكسب عند {span} بمقدار {m} dB عند Signal Level المضبوط ({chart}).",
  "analysis:diagR8Cause": "يُرجَّح أن المخروط أو فتحة الجهير بلغ حدّه.",
  "analysis:diagR8Action": "اخفض مستوى الجهير، أو أضف مرشّح تمرير عالٍ لهذه السماعة، أو دع سماعة جهير فرعية تعزف ما دون نحو {f} Hz.",
  "analysis:diagR9Obs": "عدم تماثل: التشوه من الرتب الزوجية أعلى من الفردية بما لا يقل عن 6 dB عند {span} ({chart}).",
  "analysis:diagR9Cause": "يُرجَّح وجود إزاحة في الملف الصوتي، أو عدم تماثل في التعليق، أو تيار مستمر (DC) عند خرج المضخم.",
  "analysis:diagR9ActionOn": "فعّل التصحيح (يعطي البند الأول الانخفاض المتوقع).",
  "analysis:diagR9ActionOff": "تحقق من وجود تيار مستمر (DC) عند خرج المضخم.",
  "analysis:diagNotEvalObs": "تعذر التقييم: لا توجد إشارة كافية فوق أرضية الضوضاء عند {span}.",
  "analysis:diagNotEvalAction": "قرّب الميكروفون من السماعة (ليس أقرب من 0.5 m)، أو ارفع Signal Level، أو زِد Distortion Averaging، ثم أعد القياس.",
  "analysis:diagReadingNote": "هذه تفسيرات مرجّحة مستمدة من أنماط الرسوم، وليست تشخيصًا مؤكدًا.",
  // End of Distortion Diagnosis tab
  // Speaker distortion measurement screen
  "title:newMeasurement": "قياس جديد",
  "title:frequencyResponseChoice": "استجابة التردد",
  "message:frequencyResponseChoice": "يقيس استجابة التردد والاستجابة النبضية والتشوه التوافقي باستخدام المسح. استخدمه مع Room EQ وغيره من أدوات التصحيح.",
  "button:measureFrequencyResponse": "قياس استجابة التردد",
  "title:speakerDistortionChoice": "تشوه السماعات",
  "message:speakerDistortionChoice": "يقيس كيف تتشوه كل سماعة عند مستوى الصوت الذي تستمع به، ويجهّز تأثير Distortion Correction. يقيس التشوه بإشارات اختبار شبيهة بالموسيقى عند عدة مستويات ثم ينشئ منه تصحيحًا. لا يمكن تحسين سماعات كثيرة بهذا التصحيح؛ ومع ذلك تُظهر النتيجة نوع التشوه الموجود فيها. يستغرق {time} لكل قناة؛ وإشارات الاختبار عالية الصوت.",
  "button:measureSpeakerDistortion": "قياس تشوه السماعات",
  "title:measureSpeakerDistortion": "قياس تشوه السماعات",
  "label:stepSetup": "الإعداد",
  "label:stepLevelCheck": "فحص المستوى",
  "label:stepMeasure": "القياس",
  "label:channelsToMeasure": "القنوات المراد قياسها:",
  "help:channelsToMeasure": "تُقاس كل قناة على حدة، الواحدة تلو الأخرى.",
  "message:speakerDistortionBandLimited": "تقتصر إشارات الاختبار على: {bands}، لذا يُعدّ التصحيح لقناة لا تشغّل إلا هذا النطاق. لقياس سماعة كاملة النطاق، اضبط «نطاق المسح» على «إيقاف».",
  "message:speakerDistortionBandUnmeasurable": "لا يمكن قياس التشوه مع إعداد «نطاق المسح» الحالي ({bands})، لأن التشوه يُقاس بين 50 Hz و8 kHz، ولا يكاد هذا الإعداد يترك شيئًا من هذا النطاق. وسّع «نطاق المسح»، أو ألغِ تحديد هذه القناة في «القنوات المراد قياسها».",
  "message:amplifierVolume": "اضبط المضخم على أعلى مستوى صوت تستمع به. يُنشأ التصحيح لمستوى صوت المضخم هذا. بعد ذلك يُفضَّل تغيير مستوى الصوت داخل EffeTune. إذا خفضت صوت المضخم لاحقًا، فشغّل «إعادة الفحص» ليتبع التصحيح هذا التغيير. وإذا رفعته فوق هذا المستوى، فأعد القياس.",
  "label:microphonePosition": "موضع الميكروفون:",
  "option:inFront": "أمام السماعة (موصى به)",
  "option:listeningPosition": "موضع الاستماع (لا حاجة إلى تحريك الميكروفون؛ وغالبًا يكون التصحيح أقل)",
  "help:microphonePosition": "يُحسب التصحيح من السماعة نفسها، وهذا يعطي أفضل نتيجة في معظم المقاعد. الأرقام المعروضة تخص موضع الميكروفون؛ وعند مقعدك يكون الانخفاض مماثلًا دون نحو 2 kHz، وغالبًا أصغر فوق ذلك.",
  "message:placeInFront1": "ضع الميكروفون على بعد 0.5–1 m (20–40 بوصة) أمام السماعة المراد قياسها، موجَّهًا نحوها.",
  "message:placeInFront2": "اضبطه على الارتفاع الواقع في منتصف المسافة بين الووفر والتويتر (وفي السماعة ذات المشغّل الواحد، عند مركزه). أبعده عن الطاولات والجدران.",
  "message:placeInFront3": "في غرفة كثيرة الصدى، استخدم مسافة 0.5 m.",
  "help:placeInFrontWhy": "على هذه المسافة يسمع الميكروفون الووفر والتويتر بالتوازن نفسه الذي تسمعه به. وكلما اقترب الميكروفون قلّ تأثير صدى الغرفة. أما قرب الووفر جدًا فيسمع الووفر في الغالب، وتقل دقة التصحيح فوق نطاق الجهير.",
  "message:placeListeningPosition": "اترك الميكروفون في موضع الاستماع، موجَّهًا نحو السماعات، لجميع القنوات.",
  "label:diagramSpeaker": "السماعة",
  "label:diagramMicrophone": "الميكروفون",
  "label:diagramDistance": "0.5–1 m",
  "label:distortionAveraging": "Distortion Averaging:",
  "status:perChannelTime": "{time} لكل قناة",
  "help:distortionAveraging": "كلما زاد التوسط قلّت الضوضاء في النتيجة، لكنه يستغرق وقتًا أطول. يستغرق Quick نحو نصف وقت ×2، لكن التصحيح يكون أقل دقة.",
  "label:distortionSignalLevel": "Signal Level:",
  "help:speakerDistortionSignalLevel": "يحدد مدى ارتفاع صوت إشارات الاختبار. تُشغَّل الذروات العالية القصيرة بمستوى أعلى بمقدار 10 dB؛ وعند −10 dBFS تبلغ المقياس الكامل. اخفضه إذا بدا الصوت مجهدًا أثناء فحص المستوى. يظل التصحيح يعمل عند مستوى الصوت الذي تستمع به.",
  "label:retryOnNoise": "Retry on Noise:",
  "option:retryOnNoiseOn": "تشغيل",
  "option:retryOnNoiseOff": "إيقاف",
  "help:retryOnNoise": "تُعاد إشارة الاختبار متعددة النغمات حتى مرتين إضافيتين إذا كان تسجيلها شديد الضجيج أو غير صالح للقياس.",
  "label:durationMinute": "حوالي دقيقة",
  "label:durationMinutes": "حوالي {n} دقيقة",
  "message:speakerDistortionWaitForUpdate": "انتظر حتى ينتهي تحديث النتيجة.",
  "message:speakerDistortionNeedsSampleRate": "يتطلب هذا القياس معدل أخذ عينات 44.1 kHz أو أعلى. اختر معدل أخذ عينات أعلى لجهاز الصوت.",
  "title:beforeYouStart": "قبل أن تبدأ",
  "message:noticeTime": "بعد فحص المستوى، يستغرق القياس {total} لعدد {n} من القنوات ({each} لكل قناة)، ويشمل فحص تصحيح قصيرًا في نهاية كل قناة.",
  "message:noticeTimeOne": "بعد فحص المستوى، يستغرق القياس {total}، ويشمل فحص تصحيح قصيرًا في النهاية.",
  "message:noticeLoud": "الصوت عالٍ. تُشغَّل إشارات الاختبار بمستوى صوت المضخم الذي ضبطته، وتبلغ الذروات القصيرة مستوى الخرج الكامل لنظامك.",
  "message:noticeLoudPeak": "الصوت عالٍ. تُشغَّل إشارات الاختبار بمستوى صوت المضخم الذي ضبطته، وتبلغ الذروات القصيرة {peak} dBFS.",
  "message:noticeLoudOdd": "عندما يبدو تصحيح الرتب الفردية مفيدًا، يُشغَّل نحو 20 ثانية إضافية بمستوى صوت مرتفع للتأكد من أنه لا يضر عنده. وهذا أعلى صوت متواصل في القياس.",
  "message:noticePeople": "إذا كان بالقرب منك أشخاص أو حيوانات أليفة، فأخبرهم أو اطلب منهم مغادرة الغرفة. وإذا بقيت قرب السماعة، فمن الحكمة ارتداء واقٍ للأذنين. وراعِ جيرانك أيضًا.",
  "message:noticeCancelIfNoise": "إذا سمعت طقطقة أو احتكاكًا أو طرقة قوية من السماعة، فاضغط «إلغاء» فورًا.",
  "message:noticeSilence": "أبقِ الغرفة هادئة قدر الإمكان حتى ينتهي القياس. أي صوت غير إشارة الاختبار يصل إلى الميكروفون، مثل الأصوات والخطوات والمراوح وأجهزة التكييف أو الضوضاء الخارجية، يقلل دقة النتيجة. أوقف ما تستطيع إيقافه، وأغلق الأبواب والنوافذ، والزم السكون والهدوء.",
  "message:noticeMicrophone": "ثبّت الميكروفون بإحكام على حامل بحيث لا يتحرك إطلاقًا، ولا تلمسه ولا تلمس حامله أو كابله حتى ينتهي القياس. لا تمسكه بيدك. يُجرى فحص مستوى قصير قبل كل قناة.",
  "message:noticeMicrophoneInFront": "ثبّت الميكروفون بإحكام على حامل بحيث لا يتحرك إطلاقًا أثناء قياس القناة، ولا تلمسه ولا تلمس حامله أو كابله. لا تمسكه بيدك. قبل كل قناة يُطلب منك نقله أمام تلك السماعة، ثم يُجرى فحص مستوى قصير.",
  "message:noticeExpectation": "لا يمكن تحسين سماعات كثيرة بهذا التصحيح. ومع ذلك تُظهر النتيجة نوع التشوه الموجود في سماعاتك.",
  "message:targetChannel": "سيُقاس تشوه السماعات على {ch}.",
  "message:targetInFront": "ضع الميكروفون على بعد 0.5–1 m (20–40 بوصة) أمام تلك السماعة، على الارتفاع الواقع في منتصف المسافة بين الووفر والتويتر.",
  "message:targetListeningPosition": "اترك الميكروفون في موضع الاستماع.",
  "button:runLevelCheck": "تشغيل فحص المستوى",
  "help:levelCheck": "يشغّل نحو 5 ثوانٍ من إشارات الاختبار على القناة الأولى، بما فيها أعلاها صوتًا.",
  "status:levelChecking": "جارٍ فحص المستوى…",
  "message:levelCheckOk": "اجتاز فحص المستوى. بقيت أعلى إشارة اختبار أقل من حد الميكروفون بنحو {db} dB. نسبة الإشارة إلى الضوضاء: نحو {snr} dB.",
  "help:levelCheckLoudest": "لن تتجاوز ذروات القياس مستوى الدفعة القصيرة التي سمعتها للتو. إذا كانت مزعجة أو بدت السماعة مجهدة، فارجع واخفض Signal Level.",
  "warning:levelCheckOverload": "إدخال الميكروفون محمَّل فوق طاقته. {advice}، ثم أعد الفحص.",
  "advice:hotInFront": "أبعد الميكروفون قليلًا (يجب أن يبقى ضمن 1 m) أو اخفض مكسب الميكروفون",
  "advice:hotListeningRun": "اخفض مكسب الميكروفون",
  "advice:hotListeningSetup": "اخفض مكسب الميكروفون أو اخفض Signal Level",
  "warning:levelCheckQuiet": "يلتقط الميكروفون القليل من إشارة الاختبار أو لا يلتقط منها شيئًا. تأكد من اختيار الميكروفون وقناة الإدخال الصحيحين، ومن أن الميكروفون غير مكتوم ومتجه نحو السماعة، أو ارفع مكسب الميكروفون، ثم أعد الفحص.",
  "warning:levelCheckSnrGain": "نسبة الإشارة إلى الضوضاء منخفضة: تصحيح تشوه بنسبة 1 % يتطلب 40 dB على الأقل. ارفع مكسب الميكروفون بما يصل إلى نحو {gain} dB أو اجعل الغرفة أهدأ، ثم أعد الفحص. ويمكنك أيضًا بدء القياس كما هو، لكن التصحيح سيكون أقل دقة.",
  "warning:levelCheckSnr": "نسبة الإشارة إلى الضوضاء منخفضة: تصحيح تشوه بنسبة 1 % يتطلب 40 dB على الأقل. اجعل الغرفة أهدأ، ثم أعد الفحص. ويمكنك أيضًا بدء القياس كما هو، لكن التصحيح سيكون أقل دقة.",
  "help:keepAmplifier": "اترك مستوى صوت المضخم كما هو.",
