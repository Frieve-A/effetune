  "option:effectPipelineNone": "None",
  "option:effectPipelineCurrent": "Current pipeline",
  "help:effectPipeline": "Choose Current pipeline to play the test signal through the effect pipeline that was running when this page was opened from the main app. Sampling Frequency and Output Device Channels are set to match the pipeline.",
  "help:effectPipelineUnavailable": "To measure through the effect pipeline, open this page from the main app while audio processing is running.",
