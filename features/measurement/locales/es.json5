  "analysis:evenRow": "Orden par, {band}",
  "status:passesChecks": "Supera las comprobaciones",
  "status:off": "Desactivado",
  "analysis:groupMeasured": "Con el Signal Level configurado — medido en la comprobación de la corrección",
  "analysis:groupPredictedStale": "Con el Signal Level configurado — predicho (ejecuta Volver a comprobar para medirlo)",
  "analysis:groupOtherLevels": "Otros niveles — predichos a partir de la medición",
  "analysis:oddDetailsHeader": "Corrección de orden impar: cambio respecto al mismo ajuste sin ella (medido)",
  "analysis:configShortOdd": "Short + orden impar",
