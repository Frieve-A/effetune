// Measurement Config Screen
"title:measurementConfig": "माप कॉन्फ़िगरेशन", // Title for the measurement configuration section
"label:measurementName": "माप का नाम:", // Label for measurement name input
"placeholder:measurementName": "इस माप के लिए एक नाम दर्ज करें", // Placeholder text for measurement name input
"help:measurementName": "आप जो माप करने जा रहे हैं, उसे एक नाम दें।", // Help text for measurement name
"label:audioInput": "ऑडियो इनपुट डिवाइस:", // Label for audio input device selection
"label:inputChannel": "इनपुट चैनल:", // Label for input channel selection
"help:inputChannel": "चयनित ऑडियो इनपुट डिवाइस के लिए उस चैनल का चयन करें जिसमें कैलिब्रेशन माइक्रोफोन जुड़ा है।", // Help text for input channel
"label:audioOutput": "ऑडियो आउटपुट डिवाइस:", // Label for audio output device selection
"help:audioOutput": "उस ऑडियो डिवाइस का चयन करें जो माप संकेत आउटपुट करता है।", // Help text for audio output
"label:effectPipeline": "इफेक्ट पाइपलाइन:",
"option:effectPipelineNone": "कोई नहीं",
"option:effectPipelineCurrent": "वर्तमान पाइपलाइन",
"help:effectPipeline": "मुख्य ऐप से यह पेज खोलते समय चल रही इफेक्ट पाइपलाइन से होकर टेस्ट सिग्नल चलाने के लिए वर्तमान पाइपलाइन चुनें। नमूना आवृत्ति और आउटपुट डिवाइस के चैनलों की संख्या पाइपलाइन के अनुसार तय हो जाती है।",
"help:effectPipelineUnavailable": "इफेक्ट पाइपलाइन से होकर मापने के लिए, ऑडियो प्रोसेसिंग चलते समय मुख्य ऐप से यह पेज खोलें।",
"help:effectPipelineAndroid": "Android पर इफेक्ट पाइपलाइन से होकर माप उपलब्ध नहीं है।",
"label:pipelineInputChannel": "पाइपलाइन इनपुट चैनल:",
"help:pipelineInputChannel": "वे पाइपलाइन इनपुट चैनल चुनें जिनमें टेस्ट सिग्नल जाएगा। पाइपलाइन का हर आउटपुट चैनल उसी नंबर वाले आउटपुट डिवाइस चैनल पर बजता है।",
  "label:outputChannelCount": "आउटपुट डिवाइस के चैनलों की संख्या:",
  "help:outputChannelCount": "आउटपुट डिवाइस की व्यवस्था के अनुसार संख्या चुनें (5.1 के लिए 6, 7.1 के लिए 8)। केवल कुछ चैनल मापने पर भी परीक्षण संकेत और मापन हमेशा इसी संख्या का उपयोग करते हैं।",
"label:outputChannel": "आउटपुट चैनल:", // Label for output channel selection
"help:outputChannel": "मापने के लिए एक या अधिक आउटपुट चैनल चुनें। सभी चैनल चुनने पर अलग-अलग चैनलों का चयन हट जाता है।", // Help text for output channel
"help:audioInput": "उस ऑडियो इनपुट डिवाइस को निर्दिष्ट करें जिसमें माप माइक्रोफोन जुड़ा है।", // Help text for audio input
"label:sampleRate": "नमूना आवृत्ति:", // Label for sample rate selection
"help:sampleRate": "माप लेते समय नमूना आवृत्ति निर्दिष्ट करें।", // Help text for sample rate
"label:sweepLength": "अनुरोधित स्वीप लंबाई (सैंपल):",
"help:sweepLength": "ESS माप संकेत की अनुरोधित लंबाई। हार्मोनिक रिस्पॉन्स अलग करने के लिए ज़रूरत पड़ने पर स्वीप अपने-आप लंबा होता है।",
"title:advancedSettings": "उन्नत सेटिंग्स",
"label:sweepBandMode": "स्वीप बैंडविड्थ:",
"option:sweepBandOff": "बंद",
"option:sweepBandCommon": "सभी चैनलों के लिए समान",
"option:sweepBandPerChannel": "प्रति चैनल",
"label:sweepBandChannel": "कॉन्फ़िगर करने वाला चैनल:",
"help:sweepBandMode": "सभी चैनलों के लिए समान या हर चैनल का अलग स्वीप बैंड चुनें। सीमा बंद होने पर ESS वास्तविक सैंपलिंग दर की सीमा में 20 Hz से 20 kHz इस्तेमाल करता है। प्रति-चैनल मोड में हर चुना आउटपुट अलग सेट कर सकते हैं।",
"label:sweepMinFreq": "न्यूनतम स्वीप आवृत्ति (Hz):", // Label for sweep minimum frequency
"help:sweepMinFreq": "स्वीप संकेत की न्यूनतम आवृत्ति Hz में। चयनित सैंपलिंग दर की नाइक्विस्ट आवृत्ति से ठीक नीचे तक 1 Hz से सेट की जा सकती है। टेस्ट संकेत भी इसी रेंज तक सीमित होता है। स्पीकर विकृति का टेस्ट सिग्नल भी इसी रेंज तक सीमित होता है। (डिफ़ॉल्ट: 20 Hz)", // Help text for sweep min frequency
"label:sweepMaxFreq": "अधिकतम स्वीप आवृत्ति (Hz):", // Label for sweep maximum frequency
"help:sweepMaxFreq": "स्वीप संकेत की अधिकतम आवृत्ति Hz में। चयनित सैंपलिंग दर की नाइक्विस्ट आवृत्ति से ऊपर के मान स्वचालित रूप से सीमित कर दिए जाते हैं। टेस्ट संकेत भी इसी रेंज तक सीमित होता है। स्पीकर विकृति का टेस्ट सिग्नल भी इसी रेंज तक सीमित होता है। (डिफ़ॉल्ट: 20000 Hz)", // Help text for sweep max frequency
"label:averaging": "सामयिक औसत:", // Label for synchronous averaging selection
"help:averaging": "उसी बिंदु पर दोहराने की संख्या। हर बार स्वीप के साथ रिस्पॉन्स घटने के लिए 2.5 सेकंड शामिल होते हैं, इसलिए अधिक दोहराव में अधिक समय लगता है।",
"label:interfaceCalibration": "ऑडियो इंटरफ़ेस कैलिब्रेशन:",
"option:noInterfaceCalibration": "कोई नहीं (बिना कैलिब्रेशन)",
"option:interfaceCalibrationPoint": "{measurement} — {point} ({date}, {sampleRate})",
"help:interfaceCalibration": "ऑडियो इंटरफ़ेस की प्रतिक्रिया हटाने के लिए सेव किया हुआ loopback माप इस्तेमाल करें। वही इंटरफ़ेस, इनपुट/आउटपुट चैनल, sampling rate और इनपुट/आउटपुट gain बनाए रखें, और कैलिब्रेशन माप के बाद gain न बदलें।",
"help:noInterfaceCalibrationCandidates": "ऑडियो इंटरफ़ेस कैलिब्रेशन इस्तेमाल करने से पहले impulse response वाला कोई बिना कैलिब्रेशन का माप बिंदु सेव करें।",
"help:interfaceCalibrationUnavailable": "इस browser में impulse responses सेव नहीं की जा सकतीं, इसलिए ऑडियो इंटरफ़ेस कैलिब्रेशन उपलब्ध नहीं है।",
"label:appliedInterfaceCalibration": "ऑडियो इंटरफ़ेस कैलिब्रेशन",
"button:next": "अगला", // Next button in configuration form to move to the Level Adjustment Screen

// Level Adjustment Screen
"button:playbackTestSignal": "वॉल्यूम जांचने के लिए टेस्ट संकेत प्लेबैक करें", // Button to play test signal
"button:stopTestSignal": "टेस्ट संकेत बंद करें", // Button to stop test signal
"label:signalLevel": "सिग्नल स्तर: ", // Label for signal level control
"help:signalLevel": "माप के लिए प्लेबैक किए जाने वाले माप संकेत का स्तर समायोजित करें।", // Help text for signal level
"title:inputLevel": "इनपुट स्तर", // Title for input level meter
"help:inputLevel": "टेस्ट संकेत चलाएँ और माइक्रोफोन गेन ऐसा समायोजित करें कि इनपुट स्तर -36dB और -6dB के बीच हो।", // Help text for input level
"warning:inputTooHigh": "इनपुट बहुत अधिक! माइक्रोफोन गेन या स्पीकर वॉल्यूम कम करें।", // Warning message for high input level
"warning:inputTooLow": "इनपुट बहुत कम। माइक्रोफोन गेन या स्पीकर वॉल्यूम बढ़ाएँ।", // Warning message for low input level
"warning:signalTooLow": "माप संकेत बहुत कम था जिससे सटीक परिणाम नहीं मिले", // Graph warning for signal level too low
"warning:signalTooHigh": "माप संकेत बहुत अधिक था जिससे सटीक परिणाम नहीं मिले", // Graph warning for signal level too high
