# Supply-chain hardening: dependency lifecycle scripts (preinstall, install,
# postinstall) never run during installs in this repository. No package in the
# committed dependency tree needs them; `npm run check:install-scripts` fails the
# build if that stops being true.
#
# To run a blocked script deliberately, name the package explicitly:
#   npm rebuild --ignore-scripts=false --foreground-scripts <package>
# Plain `npm rebuild` silently does nothing while this setting is active.
#
# This also disables implicit pre/post script hooks for `npm run`, so every
# package.json script chains its prerequisites with `&&` instead.
ignore-scripts=true
