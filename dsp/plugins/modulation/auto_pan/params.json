{
  "type": "AutoPanPlugin",
  "tolerance": { "abs": 0.000002, "policy": "per-sample" },
  "fields": [
    { "name": "rate", "key": "rt", "kind": "float", "min": 0.05, "max": 20, "step": 0.01, "default": 0.35, "unit": "Hz", "automation": { "normalization": "log" } },
    { "name": "depth", "key": "dp", "kind": "float", "min": 0, "max": 100, "step": 1, "default": 45, "unit": "%", "automation": true },
    { "name": "center", "key": "ct", "kind": "float", "min": -100, "max": 100, "step": 1, "default": 0, "unit": "%", "automation": true },
    { "name": "width", "key": "wd", "kind": "float", "min": 0, "max": 100, "step": 1, "default": 70, "unit": "%", "automation": true },
    { "name": "waveform", "key": "wf", "kind": "enum", "values": ["Sine", "Triangle"], "step": 1, "default": "Sine", "automation": true },
    { "name": "phase", "key": "ph", "kind": "float", "min": 0, "max": 360, "step": 1, "default": 0, "unit": "deg", "automation": true }
  ]
}
