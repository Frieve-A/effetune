{
  "type": "FrequencyShifterPlugin",
  "tolerance": { "abs": 0.0001, "policy": "per-sample" },
  "fields": [
    { "name": "mode", "key": "md", "kind": "enum", "default": "Shift", "values": ["Shift", "Ring Mod", "Barber-pole"] },
    { "name": "shift", "key": "sh", "kind": "float", "min": -5000, "max": 5000, "step": 0.1, "default": 8, "unit": "Hz", "automation": true },
    { "name": "carrierFrequency", "key": "cf", "kind": "float", "min": 0.1, "max": 10000, "step": 0.1, "default": 440, "unit": "Hz", "automation": { "normalization": "log" } },
    { "name": "minimumShift", "key": "mn", "kind": "float", "min": 0, "max": 5000, "step": 0.1, "default": 20, "unit": "Hz", "automation": true },
    { "name": "maximumShift", "key": "mx", "kind": "float", "min": 0, "max": 5000, "step": 0.1, "default": 800, "unit": "Hz", "automation": true },
    { "name": "rate", "key": "rt", "kind": "float", "min": 0.01, "max": 2, "step": 0.01, "default": 0.15, "unit": "Hz", "automation": { "normalization": "log" } },
    { "name": "direction", "key": "dr", "kind": "enum", "default": "Up", "values": ["Up", "Down"] },
    { "name": "stereoPhase", "key": "sp", "kind": "float", "min": 0, "max": 180, "step": 1, "default": 0, "unit": "degrees", "automation": true },
    { "name": "mix", "key": "mix", "kind": "float", "min": 0, "max": 100, "step": 1, "default": 100, "unit": "%", "automation": true }
  ]
}
