{
  "type": "AutoFilterPlugin",
  "tolerance": { "abs": 0.00001, "policy": "per-sample" },
  "fields": [
    { "name": "mode", "key": "md", "kind": "enum", "values": ["LFO", "Envelope"], "default": "LFO" },
    { "name": "filterType", "key": "ft", "kind": "enum", "values": ["Low-pass", "Band-pass", "High-pass"], "default": "Low-pass" },
    { "name": "minimumFrequency", "key": "lf", "kind": "float", "min": 20, "max": 20000, "step": 1, "default": 200, "unit": "Hz", "automation": { "normalization": "log" } },
    { "name": "maximumFrequency", "key": "hf", "kind": "float", "min": 20, "max": 20000, "step": 1, "default": 4000, "unit": "Hz", "automation": { "normalization": "log" } },
    { "name": "resonance", "key": "rs", "kind": "float", "min": 0.5, "max": 20, "step": 0.1, "default": 1.5, "unit": "Q", "automation": true },
    { "name": "mix", "key": "mx", "kind": "float", "min": 0, "max": 100, "step": 1, "default": 80, "unit": "%", "automation": true },
    { "name": "rate", "key": "rt", "kind": "float", "min": 0.05, "max": 20, "step": 0.01, "default": 0.5, "unit": "Hz", "automation": { "normalization": "log" } },
    { "name": "waveform", "key": "wf", "kind": "enum", "values": ["Sine", "Triangle"], "default": "Sine" },
    { "name": "stereoPhase", "key": "sp", "kind": "float", "min": 0, "max": 180, "step": 1, "default": 0, "unit": "deg", "automation": true },
    { "name": "sensitivity", "key": "sn", "kind": "float", "min": 0, "max": 60, "step": 1, "default": 24, "unit": "dB", "automation": true },
    { "name": "attack", "key": "at", "kind": "float", "min": 1, "max": 500, "step": 1, "default": 20, "unit": "ms", "automation": { "normalization": "log" } },
    { "name": "release", "key": "rl", "kind": "float", "min": 10, "max": 2000, "step": 1, "default": 250, "unit": "ms", "automation": { "normalization": "log" } },
    { "name": "direction", "key": "dr", "kind": "enum", "values": ["Up", "Down"], "default": "Up" }
  ]
}
