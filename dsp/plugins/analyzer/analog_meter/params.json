{
  "type": "AnalogMeterPlugin",
  "parityReference": "production-native-promoted-v1",
  "tolerance": { "abs": 0.000001, "policy": "per-sample" },
  "fields": [
    {
      "name": "mode",
      "key": "md",
      "kind": "enum",
      "values": ["VU", "PPM", "RMS", "Sample Peak", "True Peak", "Loudness", "Custom"],
      "default": "VU"
    },
    { "name": "integration", "key": "it", "kind": "float", "min": 0.05, "max": 3, "default": 0.3, "unit": "s" },
    { "name": "attack", "key": "at", "kind": "float", "min": 1, "max": 20, "default": 5, "unit": "ms" },
    { "name": "release", "key": "rt", "kind": "float", "min": 0.1, "max": 5, "default": 1.5, "unit": "s" },
    { "name": "detector", "key": "de", "kind": "enum", "values": ["Average Rectified", "RMS", "Sample Peak", "True Peak"], "default": "Average Rectified" },
    { "name": "needleResponse", "key": "nr", "kind": "float", "min": 1, "max": 3000, "default": 300, "unit": "ms" },
    { "name": "overshoot", "key": "os", "kind": "float", "min": 0, "max": 25, "default": 1.25, "unit": "%" }
  ]
}
