{
  "type": "OscillatorPlugin",
  "tolerance": { "abs": 0.00001, "policy": "per-sample" },
  "fields": [
    { "name": "frequency", "key": "fr", "kind": "float", "min": 20, "max": 96000, "step": 1, "default": 880, "unit": "Hz", "automation": { "normalization": "log" } },
    { "name": "volume", "key": "vl", "kind": "float", "min": -96, "max": 0, "step": 0.1, "default": -12, "unit": "dB" , "automation": true},
    { "name": "panning", "key": "pn", "kind": "float", "min": -1, "max": 1, "step": 1, "default": 0 , "automation": true},
    { "name": "waveform", "key": "wf", "kind": "enum", "values": ["sine", "square", "triangle", "sawtooth", "white", "pink", "impulse"], "default": "sine" },
    { "name": "mode", "key": "md", "kind": "enum", "values": ["continuous", "pulsed"], "step": 1, "default": "continuous", "automation": true },
    { "name": "interval", "key": "it", "kind": "float", "min": 100, "max": 2000, "step": 10, "default": 500, "unit": "ms" , "automation": true},
    { "name": "width", "key": "wd", "kind": "float", "min": 2, "max": 100, "step": 1, "default": 5, "unit": "ms" , "automation": true}
  ]
}
