{
  "type": "TubeSimulatorPlugin",
  "tolerance": { "abs": 0.00001, "policy": "per-sample" },
  "fields": [
    { "name": "inputVolume", "key": "dr", "kind": "float", "min": -96, "max": 0, "default": -44.0059, "unit": "dB" , "automation": true},
    { "name": "tube", "key": "tp", "kind": "enum", "default": "12AX7", "values": ["12AX7", "12AT7", "12AU7", "Bypass"] },
    { "name": "bias", "key": "bi", "kind": "float", "min": -50, "max": 50, "default": 0, "unit": "%" },
    { "name": "plate", "key": "pv", "kind": "float", "min": 150, "max": 300, "default": 250, "unit": "V" },
    { "name": "sourceZ", "key": "sz", "kind": "float", "min": 0.6, "max": 100, "default": 10, "unit": "kOhm" },
    { "name": "supply", "key": "su", "kind": "float", "min": 0.1, "max": 47, "default": 10, "unit": "kOhm" },
    { "name": "outputTrim", "key": "og", "kind": "float", "min": -48, "max": 48, "default": -7.372, "unit": "dB" , "automation": true},
    { "name": "mix", "key": "mx", "kind": "float", "min": 0, "max": 100, "default": 100, "unit": "%" , "automation": true},
    { "name": "inputReference", "key": "iv", "kind": "float", "min": 0.1, "max": 300, "default": 2.828, "unit": "Vpk" , "automation": { "normalization": "log" }},
    { "name": "negativeFeedback", "key": "nf", "kind": "float", "min": 0, "max": 30, "default": 3, "unit": "dB" },
    { "name": "outputStage", "key": "os", "kind": "enum", "default": "Power", "values": ["Line", "Power", "SingleEnded"], "rejectInvalid": true },
    { "name": "powerTube", "key": "pt", "kind": "enum", "default": "EL84", "values": ["EL84", "EL34", "6L6GC", "KT88"], "rejectInvalid": true },
    { "name": "powerBPlus", "key": "pb", "kind": "float", "min": 300, "max": 470, "default": 329.696, "unit": "V" },
    { "name": "cathodeResistor", "key": "kr", "kind": "float", "min": 270, "max": 500, "default": 270, "unit": "Ohm" },
    { "name": "screenTap", "key": "st", "kind": "enum", "default": "0", "values": ["0", "20", "43"], "rejectInvalid": true },
    { "name": "primaryImpedance", "key": "zp", "kind": "enum", "default": "8.0", "values": ["6.0", "6.6", "8.0"], "rejectInvalid": true },
    { "name": "speakerLoad", "key": "sl", "kind": "enum", "default": "15", "values": ["4", "8", "15", "16"], "rejectInvalid": true },
    { "name": "actualSpeakerLoad", "key": "rl", "kind": "float", "min": 2, "max": 32, "default": 15, "unit": "Ohm" },
    { "name": "safetyTrim", "key": "sg", "kind": "float", "min": -96, "max": 0, "default": 0, "unit": "dB" , "automation": true},
    { "name": "autoGainReduction", "key": "ag", "kind": "bool", "default": true },
    { "name": "seTube", "key": "sd", "kind": "enum", "default": "300B", "values": ["300B", "2A3"], "rejectInvalid": true },
    { "name": "seBPlus", "key": "sb", "kind": "float", "min": 250, "max": 450, "default": 400, "unit": "V" },
    { "name": "seCathodeResistor", "key": "sr", "kind": "float", "min": 700, "max": 1300, "default": 1000, "unit": "Ohm" },
    { "name": "sePrimaryImpedance", "key": "sp", "kind": "enum", "default": "3.5", "values": ["2.5", "3.5", "5.0"], "rejectInvalid": true }
  ]
}
