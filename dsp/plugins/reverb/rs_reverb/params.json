{
  "type": "RSReverbPlugin",
  "tolerance": { "abs": 0.0001, "policy": "per-sample" },
  "fields": [
    { "name": "preDelay", "key": "pd", "kind": "float", "min": 0, "max": 50, "step": 0.1, "default": 10, "unit": "ms", "automation": true },
    { "name": "roomSize", "key": "rs", "kind": "float", "min": 2, "max": 50, "step": 0.1, "default": 10, "unit": "m", "automation": true },
    { "name": "reverbTime", "key": "rt", "kind": "float", "min": 0.1, "max": 10, "step": 0.1, "default": 2.4, "unit": "s" , "automation": true},
    { "name": "density", "key": "ds", "kind": "int", "min": 4, "max": 8, "step": 1, "default": 8, "unit": "lines", "automation": true },
    { "name": "diffusion", "key": "df", "kind": "float", "min": 0.2, "max": 0.8, "step": 0.01, "default": 0.7, "unit": "ratio" , "automation": true},
    { "name": "damping", "key": "dp", "kind": "int", "min": 0, "max": 100, "step": 1, "default": 80, "unit": "%" , "automation": true},
    { "name": "highDamp", "key": "hd", "kind": "int", "min": 1000, "max": 20000, "step": 1, "default": 2000, "unit": "Hz" , "automation": true},
    { "name": "lowDamp", "key": "ld", "kind": "int", "min": 20, "max": 500, "step": 1, "default": 200, "unit": "Hz" , "automation": true},
    { "name": "mix", "key": "mx", "kind": "int", "min": 0, "max": 100, "step": 1, "default": 16, "unit": "%" , "automation": true}
  ]
}
