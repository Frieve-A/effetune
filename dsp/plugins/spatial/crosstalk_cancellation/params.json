{
  "type": "CrosstalkCancellationPlugin",
  "parityReference": "production-native-promoted-v1",
  "tolerance": { "abs": 0.0002, "policy": "per-sample" },
  "assets": [
    { "slot": 0, "format": "ET_ASSET_F32_MULTICH", "capacity": "32 MiB convolution cap" }
  ],
  "fields": [
    { "name": "latencyMode", "key": "lt", "kind": "enum", "values": ["0", "128", "256", "512", "1024"], "default": "128" },
    { "name": "filterDelaySamples", "key": "fd", "kind": "int", "min": 0, "max": 65536, "default": 2048 },
    { "name": "strength", "key": "st", "kind": "float", "min": 0, "max": 100, "step": 1, "default": 70, "unit": "%", "automation": true },
    { "name": "outputGain", "key": "og", "kind": "float", "min": -24, "max": 24, "step": 0.1, "default": 0, "unit": "dB", "automation": true }
  ]
}
