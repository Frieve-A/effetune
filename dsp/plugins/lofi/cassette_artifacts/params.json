{
  "type": "CassetteArtifactsPlugin",
  "tolerance": { "abs": 0.00001, "policy": "per-sample" },
  "fields": [
    { "name": "deckGrade", "key": "dg", "kind": "enum", "values": ["Reference", "Hi-Fi", "Consumer", "Portable"], "step": 1, "default": "Consumer", "automation": true },
    { "name": "tapeType", "key": "tp", "kind": "enum", "values": ["Type I", "Type II", "Type IV"], "step": 1, "default": "Type I", "automation": true },
    { "name": "noiseReduction", "key": "nr", "kind": "enum", "values": ["Off", "Dolby B", "Dolby C"], "step": 1, "default": "Dolby B", "automation": true },
    { "name": "bias", "key": "bs", "kind": "float", "min": -6, "max": 6, "step": 0.1, "default": 0, "unit": "dB", "automation": true },
    { "name": "recordLevel", "key": "rl", "kind": "float", "min": -12, "max": 18, "step": 0.1, "default": 9, "unit": "dB", "automation": true },
    { "name": "wowFlutter", "key": "wf", "kind": "float", "min": 0, "max": 1, "step": 0.001, "default": 0.2, "unit": "%", "automation": true },
    { "name": "hiss", "key": "hs", "kind": "float", "min": -92, "max": -42, "step": 0.1, "default": -60.5, "unit": "dB re 250 nWb/m", "automation": true },
    { "name": "dropouts", "key": "dp", "kind": "float", "min": 0, "max": 20, "step": 0.1, "default": 2, "unit": "events/min", "automation": true },
    { "name": "azimuth", "key": "az", "kind": "float", "min": -6, "max": 6, "step": 0.1, "default": 2, "unit": "arcmin", "automation": true },
    { "name": "dolbyLevelError", "key": "dl", "kind": "float", "min": -3, "max": 3, "step": 0.1, "default": 0, "unit": "dB", "automation": true },
    { "name": "output", "key": "og", "kind": "float", "min": -24, "max": 24, "step": 0.1, "default": 0, "unit": "dB", "automation": true },
    { "name": "mix", "key": "mx", "kind": "float", "min": 0, "max": 100, "step": 1, "default": 100, "unit": "%", "automation": true }
  ]
}
