{
  "type": "NoiseBlenderPlugin",
  "tolerance": { "abs": 0.00001, "policy": "per-sample" },
  "fields": [
    { "name": "noiseType", "key": "nt", "kind": "enum", "values": ["white", "pink", "brown"], "step": 1, "default": "pink", "automation": true },
    { "name": "level", "key": "lv", "kind": "float", "min": -96, "max": 0, "step": 0.1, "default": -36, "unit": "dB" , "automation": true},
    { "name": "perChannel", "key": "pc", "kind": "bool", "step": 1, "default": true, "automation": true }
  ]
}
