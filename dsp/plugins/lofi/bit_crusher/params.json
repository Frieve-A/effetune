{
  "type": "BitCrusherPlugin",
  "tolerance": { "abs": 0.00001, "policy": "per-sample" },
  "fields": [
    { "name": "bitDepth", "key": "bd", "kind": "int", "min": 4, "max": 24, "step": 1, "default": 8, "automation": true },
    { "name": "tpdfDither", "key": "td", "kind": "bool", "step": 1, "default": false, "automation": true },
    { "name": "zohFrequency", "key": "zf", "kind": "float", "min": 4000, "max": 96000, "step": 100, "default": 44100, "unit": "Hz", "automation": true },
    { "name": "bitError", "key": "be", "kind": "float", "min": 0, "max": 10, "step": 0.01, "default": 0, "unit": "%", "automation": true },
    { "name": "seed", "key": "sd", "kind": "int", "min": 0, "max": 1000, "step": 1, "default": 11, "automation": true }
  ]
}
