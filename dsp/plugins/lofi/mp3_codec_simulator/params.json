{
  "type": "MP3CodecSimulatorPlugin",
  "tolerance": { "abs": 0.00002, "rel": 0.00002, "policy": "per-sample" },
  "parityReference": "production-native-promoted-v1",
  "fields": [
    { "name": "codecRate", "key": "cr", "kind": "enum", "step": 1, "default": "44.1 kHz (MPEG-1)", "values": ["22.05 kHz (MPEG-2)", "44.1 kHz (MPEG-1)"], "rejectInvalid": true, "automation": true },
    { "name": "bitrate", "key": "br", "kind": "enum", "step": 1, "default": "64", "values": ["32", "48", "64", "80", "96", "112", "128", "160", "192", "224", "256", "320"], "rejectInvalid": true, "automation": true },
    { "name": "stereoMode", "key": "sm", "kind": "enum", "step": 1, "default": "Joint Stereo", "values": ["Joint Stereo", "Stereo"], "rejectInvalid": true, "automation": true },
    { "name": "bitReservoir", "key": "rv", "kind": "bool", "step": 1, "default": true, "automation": true },
    { "name": "outputGain", "key": "og", "kind": "float", "min": -24, "max": 12, "step": 0.1, "default": 0, "unit": "dB", "automation": true },
    { "name": "mix", "key": "mx", "kind": "float", "min": 0, "max": 100, "step": 1, "default": 100, "unit": "%", "automation": true }
  ]
}
