{
  "type": "BluetoothSBCSimulatorPlugin",
  "parityReference": "production-native-promoted-v1",
  "tolerance": { "abs": 0.00002, "rel": 0.00002, "policy": "per-sample" },
  "fields": [
    { "name": "bitpool", "key": "bp", "kind": "int", "min": 2, "max": 53, "default": 35 },
    { "name": "channelMode", "key": "cm", "kind": "enum", "default": "Joint Stereo", "values": ["Joint Stereo", "Stereo", "Dual Channel"], "rejectInvalid": true },
    { "name": "blocks", "key": "bl", "kind": "enum", "default": "16", "values": ["4", "8", "12", "16"], "rejectInvalid": true },
    { "name": "outputGain", "key": "og", "kind": "float", "min": -24, "max": 12, "default": 0, "unit": "dB", "automation": true },
    { "name": "mix", "key": "mx", "kind": "float", "min": 0, "max": 100, "default": 100, "unit": "%", "automation": true },
    { "name": "packetLoss", "key": "pl", "kind": "float", "min": 0, "max": 20, "default": 0, "unit": "%" }
  ]
}
