{
  "type": "AMRadioSimulatorPlugin",
  "tolerance": { "abs": 0.0001, "policy": "per-sample" },
  "fields": [
    { "name": "radio", "key": "rd", "kind": "bool", "step": 1, "default": true, "automation": true },
    { "name": "txBandwidth", "key": "tb", "kind": "float", "min": 2, "max": 10, "step": 0.1, "default": 6, "unit": "kHz", "automation": true },
    { "name": "preEmphasis", "key": "pe", "kind": "float", "min": 0, "max": 100, "step": 1, "default": 50, "unit": "%", "automation": true },
    { "name": "modDepth", "key": "md", "kind": "float", "min": 10, "max": 125, "step": 1, "default": 90, "unit": "%", "automation": true },
    { "name": "compression", "key": "cp", "kind": "float", "min": 0, "max": 20, "step": 0.1, "default": 6, "unit": "dB", "automation": true },
    { "name": "stereoMode", "key": "sm", "kind": "enum", "step": 1, "default": "Mono", "values": ["Mono", "C-QUAM"], "automation": true },
    { "name": "signal", "key": "sg", "kind": "float", "min": -50, "max": 0, "step": 0.1, "default": -12, "unit": "dB", "automation": true },
    { "name": "skywave", "key": "sk", "kind": "float", "min": 0, "max": 100, "step": 1, "default": 1, "unit": "%", "automation": true },
    { "name": "fadingSpeed", "key": "fd", "kind": "float", "min": 0.05, "max": 2, "step": 0.01, "default": 0.15, "unit": "Hz", "automation": { "normalization": "log" } },
    { "name": "staticRate", "key": "st", "kind": "float", "min": 0, "max": 100, "step": 0.01, "default": 0.3, "unit": "/s", "automation": true },
    { "name": "interference", "key": "in", "kind": "float", "min": -80, "max": 0, "step": 1, "default": -65, "unit": "dB", "automation": true },
    { "name": "interferenceOffset", "key": "io", "kind": "float", "min": 5, "max": 10, "step": 0.1, "default": 9, "unit": "kHz", "automation": true },
    { "name": "tuning", "key": "tn", "kind": "float", "min": -30, "max": 30, "step": 0.01, "default": 0, "unit": "kHz", "automation": true },
    { "name": "ifBandwidth", "key": "bw", "kind": "float", "min": 2, "max": 20, "step": 0.1, "default": 12, "unit": "kHz", "automation": true },
    { "name": "agcSpeed", "key": "ag", "kind": "enum", "step": 1, "default": "Fast", "values": ["Slow", "Mid", "Fast"], "automation": true },
    { "name": "detectorRc", "key": "dt", "kind": "float", "min": 20, "max": 500, "step": 1, "default": 50, "unit": "us", "automation": { "normalization": "log" } },
    { "name": "hum", "key": "hm", "kind": "float", "min": -80, "max": -20, "step": 1, "default": -70, "unit": "dB", "automation": true },
    { "name": "humFrequency", "key": "hz", "kind": "enum", "step": 1, "default": "50", "values": ["50", "60"], "automation": true },
    { "name": "speaker", "key": "sp", "kind": "enum", "step": 1, "default": "Table", "values": ["Off", "Small", "Table"], "automation": true },
    { "name": "outputGain", "key": "og", "kind": "float", "min": -24, "max": 24, "step": 0.1, "default": 0, "unit": "dB", "automation": true },
    { "name": "mix", "key": "mx", "kind": "float", "min": 0, "max": 100, "step": 1, "default": 100, "unit": "%", "automation": true }
  ]
}
