{
  "type": "AMRadioSimulatorPlugin",
  "tolerance": { "abs": 0.0001, "policy": "per-sample" },
  "fields": [
    { "name": "radio", "key": "rd", "kind": "bool", "default": true },
    { "name": "txBandwidth", "key": "tb", "kind": "float", "min": 2, "max": 10, "default": 6, "unit": "kHz" },
    { "name": "preEmphasis", "key": "pe", "kind": "float", "min": 0, "max": 100, "default": 50, "unit": "%" },
    { "name": "modDepth", "key": "md", "kind": "float", "min": 10, "max": 125, "default": 90, "unit": "%" },
    { "name": "compression", "key": "cp", "kind": "float", "min": 0, "max": 20, "default": 6, "unit": "dB" },
    { "name": "stereoMode", "key": "sm", "kind": "enum", "default": "Mono", "values": ["Mono", "C-QUAM"] },
    { "name": "signal", "key": "sg", "kind": "float", "min": -50, "max": 0, "default": -12, "unit": "dB" },
    { "name": "skywave", "key": "sk", "kind": "float", "min": 0, "max": 100, "default": 1, "unit": "%" },
    { "name": "fadingSpeed", "key": "fd", "kind": "float", "min": 0.05, "max": 2, "default": 0.15, "unit": "Hz" },
    { "name": "staticRate", "key": "st", "kind": "float", "min": 0, "max": 100, "default": 0.3, "unit": "/s" },
    { "name": "interference", "key": "in", "kind": "float", "min": -80, "max": 0, "default": -65, "unit": "dB" },
    { "name": "interferenceOffset", "key": "io", "kind": "float", "min": 5, "max": 10, "default": 9, "unit": "kHz" },
    { "name": "tuning", "key": "tn", "kind": "float", "min": -30, "max": 30, "default": 0, "unit": "kHz" },
    { "name": "ifBandwidth", "key": "bw", "kind": "float", "min": 2, "max": 20, "default": 12, "unit": "kHz" },
    { "name": "agcSpeed", "key": "ag", "kind": "enum", "default": "Fast", "values": ["Slow", "Mid", "Fast"] },
    { "name": "detectorRc", "key": "dt", "kind": "float", "min": 20, "max": 500, "default": 50, "unit": "us" },
    { "name": "hum", "key": "hm", "kind": "float", "min": -80, "max": -20, "default": -70, "unit": "dB" },
    { "name": "humFrequency", "key": "hz", "kind": "enum", "default": "50", "values": ["50", "60"] },
    { "name": "speaker", "key": "sp", "kind": "enum", "default": "Table", "values": ["Off", "Small", "Table"] },
    { "name": "outputGain", "key": "og", "kind": "float", "min": -24, "max": 24, "default": 0, "unit": "dB" },
    { "name": "mix", "key": "mx", "kind": "float", "min": 0, "max": 100, "default": 100, "unit": "%" }
  ]
}
