{
  "type": "SWRadioSimulatorPlugin",
  "tolerance": { "abs": 0.0001, "policy": "per-sample" },
  "fields": [
    { "name": "radio", "key": "rd", "kind": "bool", "default": true },
    { "name": "txBandwidth", "key": "tb", "kind": "float", "min": 2, "max": 10, "default": 4.5, "unit": "kHz", "automation": true },
    { "name": "preEmphasis", "key": "pe", "kind": "float", "min": 0, "max": 100, "default": 50, "unit": "%", "automation": true },
    { "name": "modDepth", "key": "md", "kind": "float", "min": 10, "max": 125, "default": 90, "unit": "%", "automation": true },
    { "name": "compression", "key": "cp", "kind": "float", "min": 0, "max": 20, "default": 6, "unit": "dB", "automation": true },
    { "name": "signal", "key": "sg", "kind": "float", "min": -50, "max": 0, "default": -15, "unit": "dB", "automation": true },
    { "name": "skywave", "key": "sk", "kind": "float", "min": 0, "max": 100, "default": 55, "unit": "%", "automation": true },
    { "name": "fadingSpeed", "key": "fd", "kind": "float", "min": 0.1, "max": 10, "default": 0.5, "unit": "Hz", "automation": { "normalization": "log" } },
    { "name": "delaySpread", "key": "ds", "kind": "float", "min": 0.2, "max": 8, "default": 1.4, "unit": "ms" },
    { "name": "staticRate", "key": "st", "kind": "float", "min": 0, "max": 100, "default": 2, "unit": "/s", "automation": true },
    { "name": "interference", "key": "in", "kind": "float", "min": -80, "max": 0, "default": -47, "unit": "dB", "automation": true },
    { "name": "interferenceOffset", "key": "io", "kind": "float", "min": 0.1, "max": 10, "default": 1, "unit": "kHz", "automation": { "normalization": "log" } },
    { "name": "tuning", "key": "tn", "kind": "float", "min": -5, "max": 5, "default": 0, "unit": "kHz", "automation": true },
    { "name": "ifBandwidth", "key": "bw", "kind": "float", "min": 2, "max": 10, "default": 6, "unit": "kHz", "automation": true },
    { "name": "detector", "key": "de", "kind": "enum", "default": "Envelope", "values": ["Envelope", "Synchronous"] },
    { "name": "agcSpeed", "key": "ag", "kind": "enum", "default": "Fast", "values": ["Slow", "Mid", "Fast"] },
    { "name": "detectorRc", "key": "dt", "kind": "float", "min": 20, "max": 500, "default": 50, "unit": "us", "automation": { "normalization": "log" } },
    { "name": "hum", "key": "hm", "kind": "float", "min": -80, "max": -20, "default": -80, "unit": "dB", "automation": true },
    { "name": "humFrequency", "key": "hz", "kind": "enum", "default": "50", "values": ["50", "60"] },
    { "name": "speaker", "key": "sp", "kind": "enum", "default": "Small", "values": ["Off", "Small", "Table"] },
    { "name": "outputGain", "key": "og", "kind": "float", "min": -24, "max": 24, "default": 0, "unit": "dB", "automation": true },
    { "name": "mix", "key": "mx", "kind": "float", "min": 0, "max": 100, "default": 100, "unit": "%", "automation": true },
    { "name": "mode", "key": "mo", "kind": "enum", "default": "AM", "values": ["AM", "USB", "LSB"] },
    { "name": "bfoOffset", "key": "bf", "kind": "float", "min": -1000, "max": 1000, "default": 0, "unit": "Hz", "automation": true }
  ]
}
