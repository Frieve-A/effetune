{
  "type": "HumGeneratorPlugin",
  "tolerance": { "abs": 0.00001, "policy": "per-sample" },
  "fields": [
    { "name": "frequency", "key": "fr", "kind": "float", "min": 10, "max": 120, "step": 0.1, "default": 50, "unit": "Hz", "automation": true },
    { "name": "humType", "key": "tp", "kind": "enum", "values": ["Standard", "Rich", "Dirty"], "step": 1, "default": "Standard", "automation": true },
    { "name": "harmonics", "key": "hm", "kind": "int", "min": 0, "max": 100, "step": 1, "default": 50, "unit": "%", "automation": true },
    { "name": "tone", "key": "tn", "kind": "float", "min": 1, "max": 20, "step": 0.1, "default": 10, "unit": "kHz", "automation": true },
    { "name": "instability", "key": "in", "kind": "float", "min": 0, "max": 10, "step": 0.1, "default": 1, "unit": "%", "automation": true },
    { "name": "level", "key": "lv", "kind": "float", "min": -80, "max": 0, "step": 0.1, "default": -40, "unit": "dB", "automation": true }
  ]
}
