{
  "type": "VinylSimulatorPlugin",
  "tolerance": { "abs": 0.0001, "policy": "per-sample" },
  "fields": [
    { "name": "cutLevel", "key": "lv", "kind": "float", "min": -20, "max": 20, "step": 0.1, "default": 0, "unit": "dB", "automation": true },
    { "name": "hfCutoff", "key": "hf", "kind": "float", "min": 6000, "max": 24000, "step": 100, "default": 16000, "unit": "Hz", "automation": true, "publicName": "highFrequencyCutoff" },
    { "name": "bassMonoBelow", "key": "mb", "kind": "float", "min": 50, "max": 1000, "step": 1, "default": 250, "unit": "Hz", "automation": true },
    { "name": "sideMix", "key": "sm", "kind": "float", "min": 0, "max": 100, "step": 1, "default": 70, "unit": "%", "automation": true },
    { "name": "speed", "key": "rp", "kind": "enum", "step": 1, "default": "33⅓", "values": ["33⅓", "45", "78"], "automation": true },
    { "name": "radius", "key": "rd", "kind": "float", "min": 60, "max": 146, "step": 1, "default": 120, "unit": "mm", "automation": true },
    { "name": "roughness", "key": "rg", "kind": "float", "min": 0.1, "max": 100, "step": 0.01, "default": 13.17, "unit": "nm", "automation": { "normalization": "log" } },
    { "name": "dustRate", "key": "dr", "kind": "float", "min": 0, "max": 10000, "step": 0.01, "default": 2, "unit": "/s", "automation": true },
    { "name": "staticRate", "key": "st", "kind": "float", "min": 0, "max": 10000, "step": 0.01, "default": 0.08, "unit": "/s", "automation": true },
    { "name": "scratchRate", "key": "sc", "kind": "float", "min": 0, "max": 1000, "step": 0.01, "default": 0, "unit": "/s", "automation": true },
    { "name": "stylusShape", "key": "sh", "kind": "enum", "default": "Elliptical", "values": ["Spherical", "Elliptical"] },
    { "name": "sideRadius", "key": "rs", "kind": "float", "min": 5, "max": 25, "step": 0.1, "default": 18, "unit": "um", "automation": true },
    { "name": "scanRadius", "key": "rc", "kind": "float", "min": 2, "max": 25, "step": 0.1, "default": 8, "unit": "um", "automation": true },
    { "name": "trackingForce", "key": "tf", "kind": "float", "min": 0.5, "max": 5, "step": 0.1, "default": 2, "unit": "g", "automation": true },
    { "name": "tipMass", "key": "tm", "kind": "float", "min": 0.1, "max": 1.5, "step": 0.01, "default": 0.4, "unit": "mg", "automation": true },
    { "name": "compliance", "key": "cm", "kind": "float", "min": 5, "max": 35, "step": 0.1, "default": 15, "unit": "cu", "automation": true },
    { "name": "damping", "key": "dz", "kind": "float", "min": 0.05, "max": 1, "step": 0.01, "default": 0.25, "unit": "zeta", "automation": true },
    { "name": "quality", "key": "ql", "kind": "enum", "step": 1, "default": "Standard", "values": ["Eco", "Standard", "High", "Ultra"], "automation": true },
    { "name": "outputGain", "key": "og", "kind": "float", "min": -24, "max": 24, "step": 0.1, "default": 0, "unit": "dB", "automation": true },
    { "name": "mix", "key": "mx", "kind": "float", "min": 0, "max": 100, "step": 1, "default": 100, "unit": "%", "automation": true }
  ]
}
